# Operations Under Pressure - Environment Configuration

# Backend Server Configuration
SERVER_PORT=8080

# Active Spring Profile:
# Leave commented or set to 'default' for embedded H2 database (zero setup required).
# Set to 'mysql' when running with MySQL container (docker compose up -d).
SPRING_PROFILES_ACTIVE=mysql

# MySQL Database Configuration (Used when SPRING_PROFILES_ACTIVE=mysql)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=newtonite_ops
DB_USER=root
DB_PASSWORD=root

# Optional direct JDBC URL override (if using a remote database)
# DB_URL=jdbc:mysql://localhost:3306/newtonite_ops?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC

# JWT Authentication
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_HOURS=24

# Frontend Configuration (for Vite)
VITE_API_BASE_URL=http://localhost:8080/api
